{
  "comp": {
    "sheet": {
      "max-width": {
        "$value": "390px",
        "$type": "dimension",
        "$description": "Sheet container max width, centered.",
        "$extensions": { "hues": { "source": "Mina §2.5 sheet container" } }
      },
      "radius": {
        "$value": "{ref.radius.sheet}",
        "$type": "dimension",
        "$description": "Sheet top corner radius.",
        "$extensions": { "hues": { "source": "Mina §2.5 sheet container" } }
      },
      "top-border": {
        "$value": "2px",
