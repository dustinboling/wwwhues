{
  "name": "@hues/tokens",
  "version": "1.0.0",
  "description": "Hues design tokens: the only raw values in the SPA program (DTCG JSON + built CSS, types, and Tailwind v4 theme mapping).",
  "private": true,
  "type": "module",
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./tokens/*": "./tokens/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tokens"
  ],
  "scripts": {
    "build:tokens": "node scripts/build-tokens.mjs",
    "build": "npm run build:tokens",
    "pretest": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node ../ui/scripts/drift-check.mjs --root .",
    "verify": "npm run lint && npm run typecheck && npm run test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@typescript-eslint/parser": "8.73.0",
    "eslint": "10.15.0",
    "style-dictionary": "5.8.0",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
