{
  "name": "tailwind-plus-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "verify:packages": "npm --prefix packages/tokens run verify && npm --prefix packages/fonts run verify && npm --prefix packages/ui run verify",
    "build:app:deps": "npm --prefix packages/tokens run build && npm --prefix packages/fonts run build && npm --prefix packages/ui run build",
    "build:app": "npm run build:app:deps && node ./scripts/fetch-snapshots.mjs && node ./scripts/prepare-spa-public.mjs && vike build && node ./scripts/write-spa-redirects.mjs && node ./scripts/fix-deploy-config.mjs",
    "deploy:app": "wrangler deploy --config dist/server/wrangler.json",
    "lint:app": "eslint --config eslint.app.config.mjs routes renderer server content sw scripts tests vite.config.mts vitest.app.config.ts playwright.app.config.ts",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "test:app": "vitest run --config vitest.app.config.ts tests/unit",
    "test:app:content": "vitest run --config vitest.app.config.ts tests/html",
    "test:app:deployed": "node ./scripts/smoke-deployed.mjs",
    "test:app:visual": "node ./scripts/run-visual.mjs",
    "verify:app": "npm run lint:app && npm run build:app:deps && npm run typecheck:app && npm run test:app && npm run build:app && npm run test:app:deployed && npm run test:app:content && npm run test:app:visual"
  },
  "browserslist": "defaults, not ie <= 11",
  "dependencies": {
    "@headlessui/react": "^2.2.6",
    "@heroicons/react": "^2.2.0",
    "@hues/fonts": "file:packages/fonts",
    "@hues/tokens": "file:packages/tokens",
    "@hues/ui": "file:packages/ui",
    "@mapbox/rehype-prism": "^0.9.0",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15",
    "@opennextjs/cloudflare": "^1.14.9",
    "@tailwindcss/postcss": "^4.1.15",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-query": "^5.108.3",
    "@types/webpack-env": "^1.18.8",
    "@vikejs/hono": "^0.4.1",
    "cheerio": "^1.1.2",
    "clsx": "^2.1.1",
    "fast-glob": "^3.3.3",
    "feed": "^5.1.0",
    "hono": "^4.13.21",
    "next": "^15",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-dom": "^19",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.15",
    "typescript": "^5.8.3",
    "vike": "^0.4.270",
    "vike-react": "^0.6.32",
    "workbox-cacheable-response": "^7.3.0",
    "workbox-core": "^7.3.0",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-range-requests": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.20.0",
    "@opennextjs/aws": "^3.9.9",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.1.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "sharp": "0.34.3",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.59.2"
  }
}
